{
  "manifest_version": 3,
  "name": "SLIIT Courseweb Cleaner",
  "version": "7.1.0",
  "description": "A professional, context-aware module filter and dark theme for SLIIT Courseweb.",
  "author": "Dulith Divisekara",
  "permissions": ["storage", "alarms", "activeTab"],
  "icons": {
    "16": "icons/icon_16.png",
    "48": "icons/icon_48.png",
    "128": "icons/icon_128.png"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon_16.png",
      "48": "icons/icon_48.png",
      "128": "icons/icon_128.png"
    },
    "default_title": "SLIIT Courseweb Cleaner",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://courseweb.sliit.lk/*"],
      "css": ["styles.css"],
      "js": ["darkreader.js", "shared-core.js", "extension-main.js"],
      "run_at": "document_idle"
    }
  ]
}